# Copie para ".env" (que nunca vai para o git) e preencha.
# Hospedado num container não existe ".env": as mesmas linhas são as variáveis de ambiente do container.

# O "Client ID" do app, em Configurações → Desenvolvedor.
GAMERFY_CLIENT_ID=

# A chave do Vercel AI Gateway (https://vercel.com/ai-gateway): é ela que paga o modelo.
AI_GATEWAY_API_KEY=

# O modelo que julga as mensagens. O padrão é o mais barato do gateway que passou no teste deste app.
# AI_MODEL=inclusionai/ling-3.0-flash

# Onde fica o Gamerfy. Sem estas duas linhas, é o de verdade (api.gamerfy.gg e gamerfy.gg).
# Num ambiente de desenvolvimento local:
# GAMERFY_API=http://localhost:4500/api/public
# GAMERFY_SITE=http://localhost:4521

# O endereço pelo qual as pessoas chegam ao app. No seu computador não precisa: é http://localhost:<porta>.
# Hospedado, é o endereço público, sempre com https:// — e o endereço de volta cadastrado no app é ele + /callback.
# PUBLIC_URL=https://moderador.exemplo.com

# A porta da página do app (o padrão é 8787; a imagem do container usa 80).
# PORT=8787

# A pasta onde fica o installs.json: quem instalou o app e as chaves de cada um. O padrão é esta pasta;
# num container, uma pasta de um volume (a imagem usa /data), senão cada reinício esquece todo mundo.
# DATA_DIR=

# "false": apaga sem avisar no chat.
# WARN_IN_CHAT=true

# "true": só julga e mostra no painel; não apaga nem escreve nada. Bom para calibrar as regras.
# DRY_RUN=false
